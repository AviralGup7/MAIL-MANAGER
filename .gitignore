node_modules/
dist/
*.log
.DS_Store
# Never commit real credentials. The previous version shipped an OAuth client
# secret in lib/auth.js; this build uses the OAuth implicit flow, which has no
# token-exchange step and therefore no secret to leak.
secrets.json
.env

# Generated by tools/make-preview.mjs. Regenerate rather than edit.
preview.html

# Generated by tools/make-bisect.mjs — throwaway diagnostic extension folders.
tools/bisect/

.benchlabs/

# Local visual-polish harnesses (round 64.5) — scratch, not shipped.
/.shot.mjs
/.shot2.mjs
/.probe*.mjs
.shot*.png

# Failure evidence: the smoke tool's scene (screenshot, DOM, console,
# trace) and the self-integrity gate's shard manifest.
.smoke-failure.*
.smoke-trace.zip
.ci-manifest.json

# Verification probes — scratch, regenerated on demand, never shipped.
#
# The `.v-*` line is here because eleven of them DID ship (round 9, H-4):
# the round-5 pattern covered `.probe-*` and `.shot-*` only, so the next
# session's naming convention walked straight past it. A leading-dot name is
# invisible in a casual `ls`, which is exactly why the glob has to be broad
# rather than a list of the names used so far.
/.shot-cp.mjs
/.census-cp.mjs
/.probe-*.mjs
/.v-*.mjs
/.chk.mjs
/.k.mjs
